# Example /opt/lldp-runner/scripts/.private for a shared installation.
#
# Copy this file to scripts/.private and protect the deployed copy. The lrun-*
# launchers source scripts/.private before invoking uv.

# Centrally managed Python installation. This prevents an operator from
# accidentally selecting a uv-managed Python below an individual home directory.
export UV_PYTHON_INSTALL_DIR="/opt/shared/python"

# Copy package files into the project environment instead of relying on links
# into a user-specific uv cache. This also matches pyproject.toml [tool.uv].
export UV_LINK_MODE="copy"

# The designated maintainer may let `uv run` verify/synchronize the centrally
# managed project environment. Other operators and service accounts use the
# already-synchronized .venv and must not trigger package changes.
#
# Files created by LLDP-Runner should remain writable by the trusted operator
# group, so operators and services use umask 0002 (setgid/default ACLs on the
# runtime directories do the same where available). The maintainer keeps
# umask 0022 because a synchronizing `uv run` writes into .venv, which must not
# become group-writable.
LLDP_RUNNER_DEVELOPER_ACCOUNT="lldp-maintainer"

if [[ "$(id -un)" == "$LLDP_RUNNER_DEVELOPER_ACCOUNT" ]]; then
    UV_RUN_ARGS=()
    umask 0022
else
    UV_RUN_ARGS=(--no-sync)
    umask 0002
fi

# uv needs a writable cache even for --no-sync runs. Service accounts usually
# have no writable home (for example /nonexistent), so fall back to a temporary
# per-invocation cache when ~/.cache/uv cannot be created. The systemd units
# installed by svc-setup.sh set UV_CACHE_DIR instead.
if [[ -z "${UV_CACHE_DIR:-}" ]] \
    && ! mkdir -p "${XDG_CACHE_HOME:-${HOME:-/nonexistent}/.cache}/uv" 2>/dev/null; then
    export UV_NO_CACHE=1
fi

# The launchers select <project>/config.toml automatically, and LLDP-Runner
# keeps runtime data with that file (/opt/lldp-runner/var for a shared
# installation). Set LLDP_RUNNER_CONFIG here only to use a different file; a
# value inherited from an operator's own shell applies only when the
# installation has no config.toml.
# export LLDP_RUNNER_CONFIG=/etc/lldp-runner/config.toml

# Optional runtime path overrides. These win over config.toml; scripts/lrun-paths
# shows the effective locations.
# export LLDP_RUNNER_ROOT=/opt/lldp-runner/var
# export LLDP_RUNNER_SCRATCH_ROOT=/dev/shm/lldp-runner
# export LLDP_RUNNER_WORKERS=auto
# export LLDP_RUNNER_BATCH_SIZE=9
# export LLDP_RUNNER_LOG_LEVEL=INFO
# export LLDP_RUNNER_BOUNDARIES=198.18.0.0/15,2001:db8::/32
# export LLDP_RUNNER_MAX_DEVICES=10
#   positive integer = recursive managed-device guardrail
#   0                = unlimited recursive managed-device discovery
#   auto             = query all unique seeds, record neighbors, do not recurse
# export LLDP_RUNNER_MAX_HOSTS=1000
#   positive integer = all hosts in recursive mode; non-seeds only in auto mode
#   0                = unlimited host identification
# export LLDP_RUNNER_SNMP_TIMEOUT=3.0
# export LLDP_RUNNER_SNMP_RPS=5.0
# export LLDP_RUNNER_SNMP_MAX_OUTSTANDING=24
# export LLDP_RUNNER_ICMP_TIMEOUT=1.0
# export LLDP_RUNNER_SNAPSHOT_INTERVAL=30
# export LLDP_RUNNER_SCOREBOARD_INTERVAL=3
# export LLDP_RUNNER_SEEDS=router1.net.example.com,router2.net.example.com
# export LLDP_RUNNER_SEED_FILES=/opt/lldp-runner/seeds/core.txt:\
#     /opt/lldp-runner/seeds/distribution.txt
# export LLDP_RUNNER_SEED_DIRS=/opt/lldp-runner/seeds.d

# Lowest-priority default SNMP credentials for simple runs. Explicit configured
# credential profiles suppress these synthesized runtime defaults. Avoid storing
# secrets here unless scripts/.private is protected appropriately.
# export SNMPCOMM=
# export SNMPUSER=
# export SNMPAUTH=
# export SNMPPRIV=

# Optional discovery ordering/sampling overrides.
# export LLDP_RUNNER_SEED_ORDER=input       # input | sorted | random
# export LLDP_RUNNER_SHUFFLE_KEY=20260820   # reproducible random-order key
# export LLDP_RUNNER_LIMIT_BEHAVIOR=pause   # pause | complete
